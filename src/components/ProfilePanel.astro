---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import type { Profile } from '../data/profiles';
import { portraitSrcset } from '../data/profiles';

type Props = {
  profile: Profile;
};

const { profile } = Astro.props;
const sourceAt = (template: string, width: number) =>
  template.replace('{width}', String(width));
const hasPortrait = existsSync(
  join(process.cwd(), 'public', sourceAt(profile.portrait.sources.jpeg, 960)),
);
const initials = profile.name
  .split(' ')
  .map((part) => part[0])
  .join('');
const panelStyle = [
  `--panel-bg:${profile.theme.background}`,
  `--panel-fg:${profile.theme.foreground}`,
  `--panel-muted:${profile.theme.muted}`,
  `--panel-accent:${profile.theme.accent}`,
  `--focal-x:${profile.portrait.focalPoint.x}`,
  `--focal-y:${profile.portrait.focalPoint.y}`,
].join(';');
const portraitSizes =
  '(max-height: 620px) and (orientation: landscape) min(22dvh, 7rem), (min-width: 768px) min(28dvh, 18rem), 8.5rem';
---

<section
  id={profile.id}
  class:list={['profile', `profile--${profile.id}`]}
  style={panelStyle}
  data-profile={profile.id}
  aria-labelledby={`${profile.id}-name`}
>
  <div class="profile__composition">
    <div
      class:list={['portrait', { 'portrait--pending': !hasPortrait }]}
      data-portrait-state={hasPortrait ? 'ready' : 'missing'}
    >
      <div class="portrait__image">
        {
          hasPortrait ? (
            <picture>
              <source
                type="image/avif"
                srcset={portraitSrcset(profile.portrait.sources.avif)}
                sizes={portraitSizes}
              />
              <source
                type="image/webp"
                srcset={portraitSrcset(profile.portrait.sources.webp)}
                sizes={portraitSizes}
              />
              <img
                src={sourceAt(profile.portrait.sources.jpeg, 960)}
                srcset={portraitSrcset(profile.portrait.sources.jpeg)}
                sizes={portraitSizes}
                width="960"
                height="960"
                alt={profile.portrait.alt}
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          ) : (
            <span class="portrait__fallback" aria-hidden="true">
              <span class="portrait__monogram">{initials}</span>
            </span>
          )
        }
      </div>
    </div>

    <div class="profile__content">
      <h2 id={`${profile.id}-name`}>{profile.name}</h2>
      <p class="profile__field" lang="en">{profile.field}</p>
      <nav class="profile__links" aria-label={`${profile.name} links`}>
        {
          profile.links.map((link) => (
            <a
              class="profile__link"
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${link.label} — ${profile.name} (opens in a new tab)`}
            >
              <span>{link.label}</span>
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M4 12L12 4M6 4h6v6" />
              </svg>
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</section>
